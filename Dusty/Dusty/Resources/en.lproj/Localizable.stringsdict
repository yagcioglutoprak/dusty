	<key>level.blocking</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@apps@</string>
		<key>apps</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%2$@ is open, so its cache is skipped. Quit it to include it.</string>
			<key>other</key>
			<string>%2$@ are open, so their caches are skipped. Quit them to include them.</string>
		</dict>
	</dict>
